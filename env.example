# Use a long random secret; never commit real secrets.
MWAECHE_JWT_SECRET=replace-with-at-least-32-random-bytes
# PostgreSQL only for deployment. Example: postgresql+psycopg://hms_app:...@127.0.0.1:5432/mwaeche_hms
MWAECHE_DATABASE_URL=postgresql+psycopg://hms_app:CHANGE_ME@127.0.0.1:5432/mwaeche_hms
MWAECHE_SERVER_ID=replace-with-a-persistent-uuid
